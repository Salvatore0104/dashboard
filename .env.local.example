# Local-only project organization sync. Never commit real credentials.
PORT=5000
DB_PATH=./claw.db
EASYAI_SYNC_MODE=mock
EASYAI_SYNC_ENABLED=true
EASYAI_ADMIN_BEARER_TOKEN=
EASYAI_CONFIG_ENCRYPTION_KEY=
# Optional existing-user identity binding endpoint, supports {user_id}.
# Blank keeps identity mapping local; organization membership sync still operates.
EASYAI_DINGTALK_BIND_PATH=
# 项目组织名称直接使用项目名称；平台当前未提供公开的组织删除接口。
EASYAI_TEST_ORG_PREFIX=
EASYAI_PARENT_ORG_NAME=执行项目组
SYNC_SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=10
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
