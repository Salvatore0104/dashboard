# Local-only project organization sync. Never commit real credentials.
PORT=5000
DB_PATH=./claw.db
EASYAI_SYNC_MODE=mock
EASYAI_SYNC_ENABLED=true
EASYAI_ADMIN_BASE_URL=https://ai.wowidea.top/api
EASYAI_ADMIN_API_KEY=
EASYAI_ADMIN_API_KEY_HEADER=X-Admin-Access-Key
EASYAI_CONFIG_ENCRYPTION_KEY=
# Required in real mode. Must be an explicit existing-user identity binding endpoint;
# supports {user_id}. Leave blank to fail closed rather than call an account-creating sync API.
EASYAI_DINGTALK_BIND_PATH=
EASYAI_TEST_ORG_PREFIX=[TEST][dashboard-local]
EASYAI_PARENT_ORG_NAME=执行项目组
SYNC_SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=10
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
